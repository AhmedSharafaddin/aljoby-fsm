# انسخه إلى .env — لا تضع أسرارًا حقيقية في هذا الملف.
# مع Docker:
DATABASE_URL="postgresql://fsm:fsm@localhost:5432/fsm"
# بلا Docker (npm run db:local):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
# قاعدة منفصلة للاختبارات (تُمسح محتوياتها في كل تشغيل)
TEST_DATABASE_URL="postgresql://fsm:fsm@localhost:5432/fsm_test"
# بلا Docker (npm run db:local -- test):
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
# عنوان التطبيق العام (لروابط تقييم العملاء) — إلزامي في الإنتاج، وبدونه يُرفض إنشاء الرابط
APP_URL="http://localhost:3000"
# المنطقة الزمنية لحساب "اليوم" والتأخير
APP_TZ="Asia/Aden"
# رمز الدولة لتطبيع أرقام الهواتف (wa.me)
COUNTRY_CODE="967"
# موقع الجوبي — مصدر الفروع (aj-platform)
WP_BASE_URL="https://aljobyfurniture.com"
# مجلد الصور والتواقيع — خارج public دائمًا
STORAGE_DIR="./storage"
# عملة التكاليف (المبالغ تُخزَّن بوحدات صغرى صحيحة)
COST_CURRENCY="ر.ي"
# مدة الاحتفاظ بمواقع الفرق المشارَكة (أيام)
LOCATION_RETENTION_DAYS="30"
# لسكربت إنشاء أول مدير فقط (scripts/create-admin.ts) — يُمرَّر عند التشغيل ولا يُحفظ هنا
# ADMIN_PHONE=
# ADMIN_PASSWORD=
# ADMIN_NAME=
